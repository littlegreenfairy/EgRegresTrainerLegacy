
Trainer: GBRLikelihoodTrain
NumberOfRegressions: 1
TMVAFactoryOptions: !V:!Silent:!Color:!DrawProgressBar
OutputDirectory: /eos/user/e/eldesant/results2023_0to50_nodR_newWeight_corrected_postBpix
Regression.1.Name: regEleEcalTrk2023_RealIC_stdVar_stdCuts_EB_ntrees1500
Regression.1.InputFiles: /eos/user/e/eldesant/results2023_0to50_nodR_newWeight_corrected_postBpix/regEleEcal2023_RealIC_RealTraining_stdVar_stdCuts_ntrees1500_applied.root
Regression.1.Tree: egRegTree
Regression.1.trainingOptions: SplitMode=random:!V
Regression.1.Options: MinEvents=300:Shrinkage=0.15:NTrees=1500:MinSignificance=5.0:EventWeight=1.0
Regression.1.DoCombine: False
Regression.1.DoEB: True
Regression.1.VariablesEB: (sc.rawEnergy+sc.rawESEnergy)*regIdealMean:regIdealSigma/regIdealMean:ele.trkPModeErr/ele.trkPMode:(sc.rawEnergy+sc.rawESEnergy)*regIdealMean/ele.trkPMode:ele.ecalDrivenSeed:ssFull.e3x3/sc.rawEnergy:ele.fbrem:ele.trkEtaMode:ele.trkPhiMode
Regression.1.VariablesEE: (sc.rawEnergy+sc.rawESEnergy)*regIdealMean:regIdealSigma/regIdealMean:ele.trkPModeErr/ele.trkPMode:(sc.rawEnergy+sc.rawESEnergy)*regIdealMean/ele.trkPMode:ele.ecalDrivenSeed:ssFull.e3x3/sc.rawEnergy:ele.fbrem:ele.trkEtaMode:ele.trkPhiMode
Regression.1.Target: (mc.energy * (ele.trkPModeErr*ele.trkPModeErr + (sc.rawEnergy+sc.rawESEnergy)*(sc.rawEnergy+sc.rawESEnergy)*regIdealMean*regIdealMean*regRealSigma*regRealSigma) / ( (sc.rawEnergy+sc.rawESEnergy)*regIdealMean*ele.trkPModeErr*ele.trkPModeErr + ele.trkPMode*(sc.rawEnergy+sc.rawESEnergy)*(sc.rawEnergy+sc.rawESEnergy)*regIdealMean*regIdealMean*regRealSigma*regRealSigma ))
Regression.1.CutBase: (mc.energy>0 && ssFrac.sigmaIEtaIEta>0 && ssFrac.sigmaIPhiIPhi>0 && mc.pt < 50 && ele.et>0 && evt.eventnr%5==2) 
Regression.1.CutEB: sc.isEB
Regression.1.CutEE: !sc.isEB
Regression.1.MeanMin: 0.2
Regression.1.MeanMax: 2.0
Regression.1.FixMean: False

